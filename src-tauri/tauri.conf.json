{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NuControle",
  "version": "1.0.0",
  "identifier": "br.com.miguelvieira.nucontrole",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Miguel Vieira",
    "copyright": "Miguel Vieira",
    "category": "Finance",
    "shortDescription": "Controle de financas pessoais",
    "longDescription": "Controle de gastos separando o que e pessoal, de terceiros e da Genesys, com fatura do cartao e caixinhas.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../run.py": "app/run.py",
      "../requirements.txt": "app/requirements.txt",
      "../backend": "app/backend",
      "../frontend": "app/frontend"
    }
  }
}
